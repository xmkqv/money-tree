#!/usr/bin/env bash
#MISE description="stop the dashboard"
set -euo pipefail

pid_file="${MISE_PROJECT_ROOT:?}/.run/web.pid"

if [[ ! -f "$pid_file" ]]; then
  echo "nothing is serving"
  exit 0
fi

pid="$(cat "$pid_file")"
rm -f "$pid_file"
if ! kill -0 "$pid" 2>/dev/null; then
  echo "nothing is serving"
  exit 0
fi

kill "$pid"
for _ in $(seq 20); do
  kill -0 "$pid" 2>/dev/null || break
  sleep 0.5
done
if kill -0 "$pid" 2>/dev/null; then
  kill -9 "$pid"
fi
echo "stopped pid $pid"
