#!/usr/bin/env bash
#MISE description="apply the Railway infrastructure"
set -euo pipefail

if [[ "${MODE:?}" != "production" ]]; then
  echo "deploy runs in production mode: rerun with --env production" >&2
  exit 1
fi
: "${RAILWAY_TOKEN:?}"

npm ci
npx railway config plan

read -r -p "apply this plan? [y/N] " answer
if [[ "$answer" != "y" ]]; then
  echo "not applied"
  exit 1
fi
npx railway config apply
