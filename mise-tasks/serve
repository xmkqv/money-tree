#!/usr/bin/env bash
#MISE description="start the dashboard in the background"
set -euo pipefail

run_dir="${MISE_PROJECT_ROOT:?}/.run"
pid_file="$run_dir/web.pid"
log_file="$run_dir/web.log"

if [[ -f "$pid_file" ]] && kill -0 "$(cat "$pid_file")" 2>/dev/null; then
  echo "already serving on ${APP_BASE_URL:?} (pid $(cat "$pid_file"))"
  exit 0
fi

mkdir -p "$run_dir"
uv run --locked uvicorn ui.app:create_app \
  --factory --workers 1 --host 127.0.0.1 --port "${PORT:?}" \
  >"$log_file" 2>&1 &
echo $! >"$pid_file"

if ! curl -sf --retry 60 --retry-connrefused --retry-delay 1 "${APP_BASE_URL:?}/healthz" >/dev/null; then
  echo "the dashboard never became healthy; see $log_file" >&2
  exit 1
fi
echo "serving ${APP_BASE_URL:?} (pid $(cat "$pid_file"))"
