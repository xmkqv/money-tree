# Strategy
STRATEGIES=noop
FRACTIONAL_ORDERS=true
RISK_PER_DAY_MAX=0.02
RISK_PER_TRADE_MAX=0.005
POSITION_FRACTION_MAX=0.10

# Alpaca
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_IS_PAPER=

# Bot state export
STATE_EXPORT_URL=http://money-tree-web.railway.internal:8080/internal/state
STATE_EXPORT_SECRET=

# Web service (local development)
APP_BASE_URL=http://127.0.0.1:8080
RAILWAY_OAUTH_CLIENT_ID=
RAILWAY_OAUTH_CLIENT_SECRET=
RAILWAY_OAUTH_REDIRECT_URI=http://127.0.0.1:8080/auth/callback
ALLOWED_RAILWAY_EMAILS=
SESSION_SECRET=

# Market data
# SIP is the consolidated tape. IEX carries a small slice of it, so bars built
# from IEX understate both volume and the width of an opening range.
#
# The breakout engines read bars for the session in progress, which SIP only
# serves on a data subscription that includes real-time consolidated data. On a
# plan without it those reads fail and the breakout scan stands down for the day
# with an error event, leaving open positions managed but taking no new trade.
# Set iex to trade on the partial feed instead, accepting narrower opening ranges
# and a share-count view of volume.
ALPACA_DATA_FEED=sip
